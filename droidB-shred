#!/usr/bin/env python3
"""droidB secure shred: destroy recoverable remnants of deleted data.

usage:
  droidB-shred --db <file.sqlite> --yes          # destroy free-space remnants in one database
  droidB-shred --backup <dir> --yes              # every SQLite database in a backup
  droidB-shred --file <path> --yes               # overwrite then remove one file
  droidB-shred --free-space <dir> --yes          # overwrite the unallocated space of a filesystem
  (omit --yes for a dry run that changes nothing)

Deleted rows live in a SQLite database's free pages until it is vacuumed, and deleted files live in a
filesystem's unallocated blocks until those blocks are reused. This destroys both:
  - a database is rewritten with secure_delete on (VACUUM), so no free-space remnant survives;
  - a filesystem's free space is overwritten by filling it, so carving finds nothing where files
    used to be.

DESTRUCTIVE. It changes the target. It is never run without --yes. On flash storage (phones, SSDs)
wear-levelling and over-provisioning mean an overwrite cannot guarantee every physical copy is gone;
the honest, complete erase of a whole device is a factory reset with encryption (a separate path).
This tool removes the remnants a recovery tool can actually reach on the files and databases it is
given.
"""
import argparse, os, sqlite3, sys, tempfile

def is_sqlite(path):
    try:
        with open(path, "rb") as f:
            return f.read(16) == b"SQLite format 3\x00"
    except OSError:
        return False

def free_pages(path):
    try:
        con = sqlite3.connect("file:%s?mode=ro" % path, uri=True)
        n = con.execute("PRAGMA freelist_count").fetchone()[0]
        con.close(); return n
    except sqlite3.Error:
        return None

def shred_db(path, do_it):
    before = free_pages(path)
    if before is None:
        return (path, "not a usable sqlite database", 0, 0)
    if not do_it:
        return (path, "would VACUUM with secure_delete", before, before)
    try:
        con = sqlite3.connect(path)
        con.execute("PRAGMA secure_delete=ON")
        con.execute("VACUUM")          # rewrites the database with no free-space remnants
        con.commit(); con.close()
    except sqlite3.Error as e:
        return (path, "VACUUM failed: %s" % e, before, before)
    after = free_pages(path)
    # also drop any -wal/-shm that could still hold remnants after a clean vacuum
    for sc in ("-wal", "-shm"):
        if os.path.isfile(path + sc):
            try: os.remove(path + sc)
            except OSError: pass
    return (path, "vacuumed", before, after)

def shred_file(path, do_it):
    try:
        size = os.path.getsize(path)
    except OSError as e:
        return (path, "stat failed: %s" % e)
    if not do_it:
        return (path, "would overwrite %d bytes then remove" % size)
    try:
        with open(path, "r+b", buffering=0) as f:
            for pat in (os.urandom, lambda n: b"\x00" * n):
                f.seek(0); rem = size
                while rem > 0:
                    chunk = min(rem, 1 << 20); f.write(pat(chunk)); rem -= chunk
                f.flush(); os.fsync(f.fileno())
        os.remove(path)
        return (path, "overwritten and removed")
    except OSError as e:
        return (path, "failed: %s" % e)

def shred_free_space(directory, do_it):
    st = os.statvfs(directory)
    free = st.f_bavail * st.f_frsize
    if not do_it:
        return (directory, "would overwrite about %.1f GB of free space" % (free / 1e9))
    pad = os.path.join(directory, ".droidB-shred-pad")
    written = 0
    try:
        with open(pad, "wb", buffering=0) as f:
            buf = b"\x00" * (1 << 20)
            try:
                while True:
                    f.write(buf); written += len(buf)
            except OSError:
                pass   # filesystem full: free blocks are now overwritten
            f.flush(); os.fsync(f.fileno())
    finally:
        try: os.remove(pad)
        except OSError: pass
    return (directory, "overwrote %.1f GB of free space" % (written / 1e9))

def find_dbs(backup):
    out = []
    for dp, _d, files in os.walk(backup):
        for fn in files:
            p = os.path.join(dp, fn)
            if is_sqlite(p):
                out.append(p)
    return out

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--db"); ap.add_argument("--backup"); ap.add_argument("--file"); ap.add_argument("--free-space")
    ap.add_argument("--yes", action="store_true", help="actually do it (otherwise a dry run)")
    a = ap.parse_args()
    do_it = a.yes
    if not any([a.db, a.backup, a.file, a.free_space]):
        print("give --db, --backup, --file or --free-space"); sys.exit(2)
    mode = "SHRED" if do_it else "DRY RUN (nothing changed)"
    print("droidB-shred  [%s]\n" % mode)

    if a.db:
        p, msg, b, af = shred_db(a.db, do_it)
        print("  %s: %s (free pages %s -> %s)" % (os.path.basename(p), msg, b, af))
    if a.backup:
        dbs = find_dbs(a.backup)
        total_before = total_after = done = 0
        for d in dbs:
            p, msg, b, af = shred_db(d, do_it)
            if b: total_before += b
            if af is not None: total_after += af
            if msg in ("vacuumed", "would VACUUM with secure_delete"): done += 1
        print("  %d database(s), %d with free space; free pages %d -> %d" % (len(dbs), done, total_before, total_after))
    if a.file:
        p, msg = shred_file(a.file, do_it); print("  %s: %s" % (os.path.basename(p), msg))
    if a.free_space:
        p, msg = shred_free_space(a.free_space, do_it); print("  %s: %s" % (p, msg))

    if not do_it:
        print("\nnothing was changed. add --yes to shred.")

if __name__ == "__main__":
    main()
