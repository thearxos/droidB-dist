            r = subprocess.run(["droidB-recover", "--ios", "--images", "--label", "iphone", "--out", out],
                               capture_output=True, text=True, timeout=36000)
            return (r.stdout + r.stderr).strip() + "\n\nrecovered data under: " + out
        self._run_async(run, self.rec_buf.set_text)

    def _rec_android_raw(self, *_):
