    def _rec_pick(self, *_):
        d = Gtk.FileChooserDialog(title="Choose a backup folder", parent=self, action=Gtk.FileChooserAction.SELECT_FOLDER)
        d.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Choose", Gtk.ResponseType.OK)
        default = os.path.expanduser("~/droidB-rescue")
