    def _rec_shred(self, *_):
        bk = self._rec_backup or self._rec_latest_rescue()
        if not bk:
            self._msg("No backup", "Choose a backup folder first."); return
        if not self._confirm("Securely shred remnants in this backup",
                             "Rewrite every database in\n%s\nso deleted data can no longer be recovered from it.\n\n"
                             "This changes the backup copy (live rows are kept). It cannot be undone. Continue?" % bk):
            return
        self.rec_buf.set_text("shredding remnants in %s…\n" % bk)
        def run():
            import subprocess
            r = subprocess.run(["droidB-shred", "--backup", bk, "--yes"], capture_output=True, text=True)
            return (r.stdout + r.stderr).strip()
        self._run_async(run, self.rec_buf.set_text)

    # ---- Spyware scan (MVT) ----
    # droidB-native drives MVT for BOTH platforms: `mvt devices` enumerates every connected phone
    # (Android over adb, iPhone over usbmuxd/idevicebackup2) and `mvt scan` acquires then analyses
    # each one. The engine streams a line at a time; this panel shows that stream live.
    def _p_mvt(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.pack_start(self._hdr("Spyware scan", "MVT forensics for Android and iPhone - acquire, then analyse, streamed live"), False, False, 0)
        r = Gtk.Box(spacing=8)
        r.pack_start(self._act("Phones", lambda *_: self._mvt_run(["mvt", "devices"], stream=False)), False, False, 0)
        r.pack_start(self._act("Update indicators", lambda *_: self._mvt_run(["mvt", "iocs"])), False, False, 0)
        self.mvt_btn = self._act("Scan all", self._mvt_scan)
        r.pack_start(self.mvt_btn, False, False, 0)
        r.pack_start(self._act("Grouped findings", lambda *_: self._mvt_group()), False, False, 0)
        r.pack_start(self._act("Report", lambda *_: self._mvt_run(["mvt", "report"], stream=False)), False, False, 0)
        box.pack_start(r, False, False, 0)
        # two stacked views: the live log, and a grouped tree of what was found
        self.mvt_stack = Gtk.Stack()
        self.mvt_view = Gtk.TextView(); self.mvt_view.set_editable(False); self.mvt_view.set_monospace(True)
        self.mvt_view.get_style_context().add_class("term"); self.mvt_buf = self.mvt_view.get_buffer()
        self.mvt_stack.add_titled(self._scroller(self.mvt_view), "log", "Live log")
        self.mvt_tree_store = Gtk.TreeStore(str, str, str)   # finding / count / detail
        self.mvt_tree = Gtk.TreeView(model=self.mvt_tree_store)
        for i, (t, exp) in enumerate([("Finding", True), ("Count", False), ("Detail", True)]):
            rnd = Gtk.CellRendererText(); col = Gtk.TreeViewColumn(t, rnd, text=i); col.set_resizable(True)
            if i == 2: rnd.set_property("ellipsize", Pango.EllipsizeMode.END)
            self.mvt_tree.append_column(col)
        self.mvt_stack.add_titled(self._scroller(self.mvt_tree), "grouped", "Grouped")
        sw = Gtk.StackSwitcher(); sw.set_stack(self.mvt_stack)
        box.pack_start(sw, False, False, 0)
        box.pack_start(self.mvt_stack, True, True, 0)
        self.mvt_note = Gtk.Label(label="MVT analyses artifacts, not a live phone: droidB copies the data off first, then checks it. Results are kept locally. Needs mvt on the host (arx install mvt); an iPhone also needs it unlocked and trusted.")
        self.mvt_note.set_xalign(0); self.mvt_note.get_style_context().add_class("sub"); self.mvt_note.set_line_wrap(True)
        box.pack_start(self.mvt_note, False, False, 0)
        self.mvt_proc = None
        return box

    def _mvt_append(self, line):
        # translate the two cryptic iOS failures into what the user must actually do
        low = line.lower()
        if "notification_proxy: password protected" in low or ("could not start service" in low and "password" in low):
            self.mvt_note.set_markup("<b>Unlock your iPhone and keep it unlocked</b>, tap Trust if asked, then Scan again. iOS blocks the backup while the phone is locked.")
        elif "pairing" in low and ("trust" in low or "denied" in low):
            self.mvt_note.set_markup("<b>Tap Trust on your iPhone</b> (unlock it first), then Scan again.")
        end = self.mvt_buf.get_end_iter(); self.mvt_buf.insert(end, line)
        if self.mvt_buf.get_line_count() > 4000:
            a = self.mvt_buf.get_start_iter(); b = self.mvt_buf.get_iter_at_line(1000); self.mvt_buf.delete(a, b)
        self.mvt_view.scroll_to_mark(self.mvt_buf.get_insert(), 0, False, 0, 0)
        return False

    def _mvt_run(self, argv, stream=True):
        # a short, read-only query (devices/report): run it and show the result
        if not stream:
            def read():
                r = subprocess.run(["droidB-native", *argv], capture_output=True, text=True, timeout=30)
                return (r.stdout + r.stderr)
            self._run_async(read, lambda out: (self.mvt_buf.set_text(out), None)[1]); return
        if self.mvt_proc:
            self._msg("Busy", "A scan or update is already running. Press Stop first."); return
        self.mvt_buf.set_text("")
        try:
            env = dict(os.environ, PYTHONUNBUFFERED="1")
            self.mvt_proc = subprocess.Popen(["droidB-native", *argv], stdout=subprocess.PIPE,
                                             stderr=subprocess.STDOUT, text=True, bufsize=1, env=env)
        except Exception as e:
            self._msg("MVT", str(e)); return
        self.mvt_btn.set_label("Stop")
        def pump():
            for line in self.mvt_proc.stdout: GLib.idle_add(self._mvt_append, line)
            GLib.idle_add(self._mvt_done)
        threading.Thread(target=pump, daemon=True).start()

    def _mvt_done(self):
        self.mvt_proc = None; self.mvt_btn.set_label("Scan all")
        self._mvt_group()   # show what the scan found, grouped
        return False

    # Human category for each MVT module, so findings read as "what it is", not a module id.
    MVT_CATEGORY = {
        "dumpsys_appops": ("App permissions", "apps granted sensitive permissions (camera, mic, location, draw-over, accessibility)"),
        "dumpsys_accessibility": ("Accessibility services", "services that can read the screen and act for you - a common spyware foothold"),
        "dumpsys_battery_daily": ("Battery usage", "apps with unusual background battery use"),
        "dumpsys_activities": ("Running activities", "foreground/background activities"),
        "dumpsys_receivers": ("Broadcast receivers", "apps listening for system events (boot, SMS, calls)"),
        "dumpsys_adb_state": ("ADB state", "debugging and authorized keys"),
        "settings": ("System settings", "security-relevant settings changed from their defaults"),
        "processes": ("Processes", "running processes"),
        "packages": ("Packages", "installed packages of interest"),
        "dbinfo": ("Databases", "app databases of interest"),
        "sms": ("SMS", "text messages with links or indicators"),
        "whatsapp": ("WhatsApp", "WhatsApp messages with links or indicators"),
        "chrome_history": ("Browser history", "visited URLs matching indicators"),
    }

    def _mvt_category(self, module):
        return self.MVT_CATEGORY.get(module, (module.replace("_", " ").replace("dumpsys ", "").title(), ""))

    def _mvt_latest_dir(self):
        base = os.path.expanduser("~/.droidB/mvt")
        if not os.path.isdir(base): return None
        dirs = [os.path.join(base, d) for d in os.listdir(base)]
        dirs = [d for d in dirs if os.path.isdir(d)]
        return max(dirs, key=os.path.getmtime) if dirs else None

    def _mvt_group(self, *_):
        import json, glob
        root = self._mvt_latest_dir()
        self.mvt_tree_store.clear()
        if not root:
            self.mvt_tree_store.append(None, ["No scan results yet", "", "Run Scan all first"])
            self.mvt_stack.set_visible_child_name("grouped"); return
        files = sorted(glob.glob(os.path.join(root, "*", "results", "alerts.json")))
        if not files:
            self.mvt_tree_store.append(None, ["No alerts file in the latest scan", "", os.path.basename(root)])
            self.mvt_stack.set_visible_child_name("grouped"); return
        LEVELS = ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO", "INFORMATIONAL"]
        total = 0; ioc_total = 0
        for af in files:
            device = af.split(os.sep)[-3]
            try:
                alerts = json.load(open(af))
            except Exception:
                continue
            if not isinstance(alerts, list): continue
            # device node, with an IOC-match tally
            iocs = [a for a in alerts if str(a.get("matched_indicator") or "None") not in ("None", "")]
            ioc_total += len(iocs); total += len(alerts)
            dev_node = self.mvt_tree_store.append(None, [
                "Device " + device, str(len(alerts)),
                ("%d matched a known-spyware indicator" % len(iocs)) if iocs else "no known-spyware indicator matched (behavioural findings only)"])
            # group by severity, then by category
            by_level = {}
            for a in alerts:
                by_level.setdefault((a.get("level") or "INFO").upper(), []).append(a)
            for lvl in LEVELS + [l for l in by_level if l not in LEVELS]:
                items = by_level.get(lvl)
                if not items: continue
                lvl_node = self.mvt_tree_store.append(dev_node, [lvl.title(), str(len(items)), ""])
                by_cat = {}
                for a in items:
                    by_cat.setdefault(a.get("module") or "other", []).append(a)
                for module, group in sorted(by_cat.items(), key=lambda kv: -len(kv[1])):
                    label, meaning = self._mvt_category(module)
                    cat_node = self.mvt_tree_store.append(lvl_node, [label, str(len(group)), meaning])
                    for a in group:
                        msg = (a.get("message") or "").strip().replace("\n", " ")
                        ind = str(a.get("matched_indicator") or "None")
                        detail = ("IOC: " + ind + " - " if ind not in ("None", "") else "") + msg[:300]
                        self.mvt_tree_store.append(cat_node, ["", "", detail])
        # a summary row at the top
        self.mvt_tree_store.insert(None, 0, [
            "Summary", str(total),
            "%d finding(s) across %d device(s); %d matched a known-spyware indicator%s" % (
                total, len(files), ioc_total,
                ". A match is worth expert review." if ioc_total else ". None matched a known indicator; these are behaviours to review, not proof of spyware.")])
        self.mvt_tree.expand_row(Gtk.TreePath.new_from_indices([1]), False)  # expand the first device
        self.mvt_stack.set_visible_child_name("grouped")

    def _mvt_scan(self, *_):
        if self.mvt_proc:
            try: self.mvt_proc.terminate()
            except Exception: pass
            self._mvt_done(); return
        self._mvt_run(["mvt", "scan"])

    # ---- Frida ----
    def _p_frida(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.pack_start(self._hdr("Frida", "dynamic instrumentation - server, processes, attach / spawn"), False, False, 0)
        r1 = Gtk.Box(spacing=8)
        r1.pack_start(self._act("Install server (auto-arch)", self._frida_install), False, False, 0)
        r1.pack_start(self._act("Start server", lambda *_: self._termrun("frida-server", "adb shell su -c '/data/local/tmp/frida-server &' 2>/dev/null || adb shell '/data/local/tmp/frida-server &'; echo started")), False, False, 0)
        r1.pack_start(self._act("Stop server", lambda *_: self._run_async(lambda: adb("shell", "pkill", "-f", "frida-server") or "stopped", self.fr_out.set_text)), False, False, 0)
        box.pack_start(r1, False, False, 0)
        r2 = Gtk.Box(spacing=8)
        r2.pack_start(self._act("List processes", lambda *_: self._need_frida() and self._termrun("frida-ps", "frida-ps -Ua")), False, False, 0)
        r2.pack_start(self._act("Attach to app…", self._frida_attach), False, False, 0)
        r2.pack_start(self._act("Spawn app…", self._frida_spawn), False, False, 0)
        box.pack_start(r2, False, False, 0)
        self.fr_out = Gtk.Label(label="needs frida-tools on the host (arx install python-frida-tools) + frida-server on the device"); self.fr_out.set_xalign(0)
        self.fr_out.get_style_context().add_class("sub"); self.fr_out.set_line_wrap(True)
        box.pack_start(self.fr_out, False, False, 0)
        return box

    def _need_frida(self):
        # the host tools must be present, and of the version the server will be fetched for; this
        # used to open a terminal that only said "frida-ps: command not found" (2026-11-02)
        if have("frida-ps") and have("frida"):
            return True
        self.fr_out.set_text("frida-tools is not installed on this computer. Install it with:  arx install python-frida-tools")
        self._msg("Frida tools missing", "Install them first:\n\n    arx install python-frida-tools\n\n"
                  "The server droidB puts on the phone is then the same version as these tools. "
                  "frida-server sees other apps only on a rooted phone.")
        return False

    def _frida_install(self, *_):
        if not self._need_device() or not self._need_frida(): return
        cmd = ("set -e; a=$(adb shell getprop ro.product.cpu.abi | tr -d '\\r'); "
               "case $a in arm64*) fa=arm64;; armeabi*) fa=arm;; x86_64) fa=x86_64;; x86) fa=x86;; *) fa=arm64;; esac; "
               "v=$(frida --version); echo \"device $fa, frida $v\"; "
               "u=https://github.com/frida/frida/releases/download/$v/frida-server-$v-android-$fa.xz; "
               "curl -fsSL $u -o /tmp/fs.xz && unxz -f /tmp/fs.xz && adb push /tmp/fs /data/local/tmp/frida-server "
               "&& adb shell chmod 755 /data/local/tmp/frida-server && echo 'frida-server installed'")
        self._termrun("install frida-server", cmd)

    def _frida_attach(self, *_):
        if not self._need_frida(): return
        app = self._prompt("Attach", "app package / name")
        if app: self._termrun("frida attach", "frida -U %s" % shlex.quote(app))

    def _frida_spawn(self, *_):
        if not self._need_frida(): return
        app = self._prompt("Spawn", "app package")
        # Frida 16 removed --no-pause: a spawned app resumes by itself, and the flag is an error
        if app: self._termrun("frida spawn", "frida -U -f %s" % shlex.quote(app))

    # ---- Security (MITM / cert / capture) ----
    def _p_security(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.pack_start(self._hdr("Security", "MITM proxy, CA certificate, packet capture"), False, False, 0)
        r1 = Gtk.Box(spacing=8)
        r1.pack_start(Gtk.Label(label="proxy host:port"), False, False, 0)
        self.sec_proxy = Gtk.Entry(); self.sec_proxy.set_placeholder_text("192.168.1.10:8080"); self.sec_proxy.set_hexpand(True)
        r1.pack_start(self.sec_proxy, True, True, 0)
        r1.pack_start(self._act("Set proxy", self._sec_setproxy), False, False, 0)
        r1.pack_start(self._act("Clear", lambda *_: self._run_async(lambda: adb("shell", "settings", "put", "global", "http_proxy", ":0") or "proxy cleared", self.sec_out.set_text)), False, False, 0)
        box.pack_start(r1, False, False, 0)
        r2 = Gtk.Box(spacing=8)
        r2.pack_start(self._act("Install CA cert…", self._sec_cert), False, False, 0)
        r2.pack_start(self._act("Start capture (tcpdump)", lambda *_: self._sec_capture(True)), False, False, 0)
        r2.pack_start(self._act("Stop + pull pcap", lambda *_: self._sec_capture(False)), False, False, 0)
        box.pack_start(r2, False, False, 0)
        self.sec_out = Gtk.Label(label="point the proxy at your Burp / mitmproxy listener, then install the CA cert to intercept HTTPS"); self.sec_out.set_xalign(0)
        self.sec_out.get_style_context().add_class("sub"); self.sec_out.set_line_wrap(True)
        box.pack_start(self.sec_out, False, False, 0)
        return box

    def _sec_setproxy(self, *_):
        if not self._need_device(): return
        hp = self.sec_proxy.get_text().strip()
        if not hp: self._msg("host:port?", "Enter your proxy as host:port."); return
        self._run_async(lambda: adb("shell", "settings", "put", "global", "http_proxy", hp) or ("proxy set to " + hp), self.sec_out.set_text)

    def _sec_cert(self, *_):
        if not self._need_device(): return
        f = self._pick("CA certificate (.pem / .crt / .cer)")
        if not f: return
        self._termrun("install CA cert", "adb push %s /sdcard/arxos-ca.crt && echo 'Pushed to /sdcard/arxos-ca.crt. On the device: Settings > Security > Encryption & credentials > Install a certificate > CA certificate.'" % shlex.quote(f))

    def _sec_capture(self, start):
        if not self._need_device(): return
        if start:
            self.sec_out.set_text("capturing… (needs tcpdump on the device / root)")
            self._termrun("tcpdump", "adb shell su -c 'tcpdump -i any -w /sdcard/arxos-cap.pcap' 2>/dev/null || adb shell tcpdump -i any -w /sdcard/arxos-cap.pcap")
        else:
            d = self._outdir()
            self._run_async(lambda: (adb("shell", "pkill", "tcpdump"), adb("pull", "/sdcard/arxos-cap.pcap", d, timeout=60), "pcap pulled to " + d)[-1], self.sec_out.set_text)


