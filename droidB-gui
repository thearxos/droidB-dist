def adb(*args, timeout=20):
    try:
        return subprocess.run(["adb", *args], capture_output=True, text=True, timeout=timeout).stdout.strip()
    except Exception:
        return ""

def rq(arg):
    # Quote one argument for the phone's shell. `adb shell a b c` joins its arguments with spaces
    # and hands that line to the phone's sh, so an unquoted path with a space became two paths:
    # pressing Delete on the folder "a b" deleted its neighbour "a" and everything in it
    # (reproduced on a Galaxy A16, 2026-11-02). Every path sent to the phone goes through here.
    return shlex.quote(str(arg))

def adb_sh(*parts, timeout=20):
    """Run one command on the phone with every part quoted. Returns (ok, output); a failure is
    reported to the caller instead of being swallowed."""
    try:
        r = subprocess.run(["adb", "shell", " ".join(rq(p) for p in parts)],
                           capture_output=True, text=True, timeout=timeout)
        return r.returncode == 0, (r.stdout + r.stderr).strip()
    except Exception as e:
        return False, str(e)

def safe_name(n):
    # a new name for mkdir/rename is one path component: no separators, no "." or ".."
    return bool(n) and "/" not in n and n not in (".", "..") and "\x00" not in n

def fastboot(*args, timeout=25):
    try:
        r = subprocess.run(["fastboot", *args], capture_output=True, text=True, timeout=timeout)
        return (r.stdout + r.stderr).strip()
    except Exception:
        return ""

def have(b):
    return subprocess.run(["bash", "-lc", "command -v " + b], capture_output=True).returncode == 0


# The terminal a long or interactive job runs in. ArxOS ships Konsole only, so a hardcoded
# xfce4-terminal opened nothing at all. The user's own choice wins when it is installed ($TERMINAL,
# or XFCE's preferred terminal, which the Control Center sets), then Konsole, then any other.
_TERMINALS = {
    "konsole":        lambda t, sh: ["konsole", "-p", "tabtitle=" + t, "-e"] + sh,
    "kitty":          lambda t, sh: ["kitty", "--title", t] + sh,
    "alacritty":      lambda t, sh: ["alacritty", "--title", t, "-e"] + sh,
    "wezterm":        lambda t, sh: ["wezterm", "start", "--"] + sh,
    "foot":           lambda t, sh: ["foot", "--title", t] + sh,
    "xfce4-terminal": lambda t, sh: ["xfce4-terminal", "--title", t, "-x"] + sh,
    "gnome-terminal": lambda t, sh: ["gnome-terminal", "--title", t, "--"] + sh,
    "xterm":          lambda t, sh: ["xterm", "-T", t, "-e"] + sh,
}


def preferred_terminal():
    names = [os.path.basename(os.environ.get("TERMINAL", ""))]
    try:
        with open(os.path.expanduser("~/.config/xfce4/helpers.rc")) as f:
            for line in f:
                if line.startswith("TerminalEmulator="):
                    names.append(line.split("=", 1)[1].strip())
    except OSError:
        pass
    return [n for n in names if n in _TERMINALS]


def terminal_argv(title, cmd):
    """argv that runs the bash command line `cmd` in a terminal titled `title`, or None."""
    import shutil
    for name in preferred_terminal() + list(_TERMINALS):
        if shutil.which(name):
            return _TERMINALS[name](title, ["bash", "-lc", cmd])
    return None


