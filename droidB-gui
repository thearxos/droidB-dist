    def _rec_latest_rescue(self):
        base = os.path.expanduser("~/droidB-rescue")
        if not os.path.isdir(base): return None
        subs = [os.path.join(base, x) for x in os.listdir(base) if os.path.isdir(os.path.join(base, x))]
        return max(subs, key=os.path.getmtime) if subs else None

    def _rec_scan(self, *_):
        bk = self._rec_backup or self._rec_latest_rescue()
        if not bk:
            self._msg("No backup", "Choose a backup folder, or make one first in the Backup tab."); return
        self._rec_backup = bk; self.rec_path.set_text(bk)
        out = os.path.join(os.path.expanduser("~/droidB/recovery"), os.path.basename(bk.rstrip("/")))
        self.rec_buf.set_text("scanning %s for deleted data…\n" % bk)
        def run():
            import subprocess
            r = subprocess.run(["droidB-recover", "--backup", bk, "--images", "--label", "device", "--out", out],
                               capture_output=True, text=True)
            return (r.stdout + r.stderr).strip() + "\n\nrecovered files are under: " + out
        self._run_async(run, self.rec_buf.set_text)

    def _rec_android(self, *_):
        if self._state() != "device":
            self._msg("No device", "Connect an Android phone with USB debugging, then retry. Rooted phones also recover SMS, calls and contacts; without root this recovers deleted-photo thumbnails and any accessible databases."); return
        out = os.path.join(os.path.expanduser("~/droidB/recovery"), "android-live")
        self.rec_buf.set_text("pulling databases and thumbnail caches from the phone, then recovering deleted data…\n")
        def run():
            import subprocess
            r = subprocess.run(["droidB-recover", "--android", "--label", "android", "--out", out],
                               capture_output=True, text=True, timeout=600)
            return (r.stdout + r.stderr).strip() + "\n\nrecovered data (incl. carved_images/) under: " + out
        self._run_async(run, self.rec_buf.set_text)

    def _rec_ios(self, *_):
        ios = self._ios_device()
        if not ios:
            self._msg("No iPhone", "Connect an iPhone, unlock it and tap Trust. Then retry."); return
