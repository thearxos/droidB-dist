        return box

    def _run_async(self, fn, done=None):
        # A worker that raised used to die silently: `done` never ran, so the panel stayed on
        # its last text and every button in it looked dead (2026-11-02: one formatting slip in the
        # Device panel). Now the traceback is logged and the panel is told what failed.
        def work():
            try:
                out = fn()
            except Exception as e:
                import traceback
                tb = traceback.format_exc()
                sys.stderr.write(tb)
                try:
                    with open(os.path.join(self._outdir(), "droidB-gui.log"), "a") as f:
                        f.write(time.strftime("%Y-%m-%d %H:%M:%S ") + tb)
                except OSError:
                    pass
                out = "error: %s: %s (details in ~/droidB/droidB-gui.log)" % (type(e).__name__, e)
            if done:
                def deliver():
                    try:
                        done(out)
                    except Exception:
                        import traceback
                        sys.stderr.write(traceback.format_exc())
                    return False
                GLib.idle_add(deliver)
        threading.Thread(target=work, daemon=True).start()

