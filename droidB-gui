    def _outdir(self):
        d = os.path.expanduser("~/droidB"); os.makedirs(d, exist_ok=True); return d

    def _screenshot(self, *_):
        if not self._need_device(): return
        path = os.path.join(self._outdir(), "shot-%d.png" % int(time.time()))
        def run():
            try:
                with open(path, "wb") as f:
                    subprocess.run(["adb", "exec-out", "screencap", "-p"], stdout=f, timeout=20)
                return path
            except Exception as e: return str(e)
        def done(p):
            self.scr_out.set_text("saved " + p)
            if os.path.exists(p): self.scr_img.set_from_file(p)
        self._run_async(run, done)

    def _screenrecord(self, *_):
        if not self._need_device(): return
        rp = "/sdcard/droidB-rec.mp4"; lp = os.path.join(self._outdir(), "rec-%d.mp4" % int(time.time()))
        self.scr_out.set_text("recording 10s…")
        def run():
            adb("shell", "screenrecord", "--time-limit", "10", rp, timeout=20)
            adb("pull", rp, lp, timeout=60); adb_sh("rm", "-f", "--", rp)
            return "saved " + lp
        self._run_async(run, self.scr_out.set_text)

    def _net_sync_keep_checkbox(self):
        addr = self.net_saved.get_active_id()
        if not addr: return
        _c, data = self._net_store()
        self.net_keep.handler_block_by_func(self._net_keep_toggled)
        self.net_keep.set_active(bool(data.get(addr, {}).get("keep")))
        self.net_keep.handler_unblock_by_func(self._net_keep_toggled)

    def _net_keep_toggled(self, btn):
        import json
        addr = self.net_saved.get_active_id()
        if not addr: return
        cfg, data = self._net_store()
        data.setdefault(addr, {})["keep"] = btn.get_active()
        json.dump(data, open(cfg, "w"), indent=2)
        if btn.get_active():
            self._net_keepalive()   # connect now, then the timer keeps it alive

    def _net_keepalive(self):
        """Reconnect every saved device marked keep=on. adb connect to an already-connected device
        is a cheap no-op, so this quietly re-establishes a WAN/LAN link that dropped (IP change,
        sleep, roaming) with no manual step. Runs off the UI thread."""
        _c, data = self._net_store()
        targets = [a for a, m in data.items() if m.get("keep")]
        if targets:
            def work():
                for a in targets:
                    try: subprocess.run(["adb", "connect", a], capture_output=True, text=True, timeout=12)
                    except Exception: pass
            threading.Thread(target=work, daemon=True).start()
        return True   # keep the GLib timer running

    def _net_store(self):
        import json
        cfg = os.path.join(os.path.expanduser("~/.config/droidB"), "devices.json")
        os.makedirs(os.path.dirname(cfg), exist_ok=True)
        try:
            return cfg, json.load(open(cfg))
        except Exception:
            return cfg, {}

    def _net_reload_saved(self):
        _c, data = self._net_store()
        self.net_saved.remove_all()
        for addr, meta in sorted(data.items()):
            self.net_saved.append(addr, "%s  (%s)" % (meta.get("name", addr), addr))
        if data: self.net_saved.set_active(0)

    def _net_save(self, addr, name):
        import json
        cfg, data = self._net_store()
        data[addr] = {"name": name}
        json.dump(data, open(cfg, "w"), indent=2)
        self._net_reload_saved()

    def _net_homelink(self, *_):
        # one-time setup to make a connected phone a persistent home node (no root, no account
        # removal, no Google): runs setup-homelink.sh over the USB connection.
        if self._state() != "device":
            self._msg("Plug in once", "Connect the phone over USB (debugging on). This one-time step makes it reachable forever, no cable afterwards."); return
        if not self._confirm("Set up this phone as a home device",
                             "One-time, over USB, no root, nothing removed from the phone:\n\n"
                             "- make Termux survive battery optimisation and reboots\n"
                             "- turn on wireless ADB so you reach it over the network\n"
                             "- hide the Termux icons so they are not deleted (the app keeps running)\n\n"
                             "You will finish by installing Termux + Termux:Boot + Termux:API and Tailscale "
                             "from F-Droid on the phone (open source, no Google). Continue?"):
            return
        self.net_out.set_text("setting up the home device over USB…")
        def run():
            import subprocess, shutil
            script = shutil.which("setup-homelink.sh") or "/usr/local/share/droidB/setup-homelink.sh"
            if not os.path.exists(script):
                # fall back to the copy beside the GUI during development
                here = os.path.dirname(os.path.realpath(__file__))
                for c in (os.path.join(here, "arxlink", "setup-homelink.sh"), os.path.join(here, "setup-homelink.sh")):
                    if os.path.exists(c): script = c; break
            r = subprocess.run(["bash", script], capture_output=True, text=True, timeout=300)
            return (r.stdout + r.stderr).strip()
        self._run_async(run, self.net_out.set_text)

    def _net_enable(self, *_):
        # plug in over USB once; switch the phone to TCP mode and save its LAN endpoint
        if self._state() != "device":
            self._msg("Plug in once", "Connect the phone over USB (debugging on) for this one-time step. After it, the cable is not needed on your network."); return
        self.net_out.set_text("switching the phone to Wi-Fi ADB…")
        def run():
            ip = adb("shell", "ip", "-f", "inet", "addr", "show", "wlan0", timeout=5)
            import re
            m = re.search(r"inet (\d+\.\d+\.\d+\.\d+)", ip)
            if not m: return "could not read the phone's Wi-Fi IP - is it on Wi-Fi?"
            host = m.group(1)
            subprocess.run(["adb", "tcpip", "5555"], capture_output=True, text=True, timeout=10)
            import time as _t; _t.sleep(2)
            r = subprocess.run(["adb", "connect", "%s:5555" % host], capture_output=True, text=True, timeout=10)
            addr = "%s:5555" % host
            name = adb("shell", "getprop", "ro.product.model", timeout=4) or "phone"
            GLib.idle_add(self._net_save, addr, name)
            return (r.stdout + r.stderr).strip() + "\nsaved %s - you can unplug the cable now and use 'Mirror over network'." % addr
        self._run_async(run, self.net_out.set_text)

    def _net_connect(self, *_):
        addr = self.net_addr.get_text().strip()
        if not addr:
            self._msg("Address", "Enter the phone's address as ip:port (LAN 192.168.x.x:5555, or an overlay/WAN address)."); return
        if ":" not in addr: addr += ":5555"
        self.net_out.set_text("connecting to %s…" % addr)
        def run():
            r = subprocess.run(["adb", "connect", addr], capture_output=True, text=True, timeout=15)
            out = (r.stdout + r.stderr).strip()
            if "connected" in out.lower():
                GLib.idle_add(self._net_save, addr, addr)
            return out
        self._run_async(run, self.net_out.set_text)

    def _net_mirror(self, *_):
        addr = self.net_saved.get_active_id() or self.net_addr.get_text().strip()
        if not addr:
            self._msg("No saved device", "Save a device first (Enable Wi-Fi ADB, or Connect + save)."); return
        if not self._ensure_scrcpy(): return
        if getattr(self, "_mirror_thread", None) and self._mirror_thread.is_alive():
            self._mirror_stop = True   # a second click stops an existing keep-alive mirror
            return
        self._mirror_stop = False
        def run():
            subprocess.run(["adb", "connect", addr], capture_output=True, text=True, timeout=15)
            GLib.idle_add(self.net_out.set_text, "mirroring %s (auto-relaunch on; click Mirror again to stop)" % addr)
            # keep the mirror up: relaunch scrcpy if it dies while the device is still connected
            while not self._mirror_stop:
                p = subprocess.Popen(["scrcpy", "-s", addr])
                p.wait()
                if self._mirror_stop:
                    break
                # only relaunch if the device is still there (a real drop vs the user closing it)
                st = subprocess.run(["adb", "-s", addr, "get-state"], capture_output=True, text=True, timeout=8)
                if "device" not in st.stdout:
                    subprocess.run(["adb", "connect", addr], capture_output=True, text=True, timeout=15)
                import time as _t; _t.sleep(2)
            GLib.idle_add(self.net_out.set_text, "mirror stopped")
        import threading as _th
        self._mirror_thread = _th.Thread(target=run, daemon=True); self._mirror_thread.start()

    def _net_checkup(self, *_):
        addr = self.net_saved.get_active_id() or self.net_addr.get_text().strip()
        if not addr:
            self._msg("No device", "Save a home device first."); return
        host = addr.rsplit(":", 1)[0]
        self.net_out.set_text("reading %s status over the tunnel…" % host)
        def run():
            import urllib.request, json as _j
            try:
                with urllib.request.urlopen("http://%s:8098/" % host, timeout=8) as r:
                    d = _j.loads(r.read().decode())
            except Exception as e:
                return "could not reach the status helper on %s (is arxlink-status running on the phone?): %s" % (host, e)
            lines = ["%s:" % host,
                     "  screen: %s" % d.get("screen"),
                     "  using now: %s" % d.get("foreground")]
            bat = d.get("battery") or {}
            if isinstance(bat, dict) and bat:
                lines.append("  battery: %s%% %s" % (bat.get("percentage", "?"), bat.get("status", "")))
            loc = d.get("location") or {}
            if isinstance(loc, dict) and loc.get("latitude"):
                lines.append("  location: %s, %s" % (loc.get("latitude"), loc.get("longitude")))
            use = d.get("usage") or []
            if use:
                lines.append("  recent apps: %s" % ", ".join(str(u)[:40] for u in use[:6]))
            return "\n".join(lines)
        self._run_async(run, self.net_out.set_text)

    def _net_find(self, what):
        addr = self.net_saved.get_active_id() or self.net_addr.get_text().strip()
        if not addr: 
            self._msg("No device", "Save a home device first."); return
        host = addr.rsplit(":", 1)[0]
        self.net_out.set_text("asking %s to %s…" % (host, what))
        def run():
            import urllib.request
            try:
                with urllib.request.urlopen("http://%s:8097/%s" % (host, what), timeout=25) as r:
                    return r.read().decode().strip() or "(done)"
            except Exception as e:
                return "could not reach the find helper on %s: %s" % (host, e)
        self._run_async(run, self.net_out.set_text)

    def _net_forget(self, *_):
        import json
        addr = self.net_saved.get_active_id()
        if not addr: return
        cfg, data = self._net_store()
        data.pop(addr, None); json.dump(data, open(cfg, "w"), indent=2)
        subprocess.run(["adb", "disconnect", addr], capture_output=True)
        self._net_reload_saved(); self.net_out.set_text("forgot %s" % addr)

    def _mirror(self, *_):
        if not self._need_device(): return
        if not self._ensure_scrcpy(): return
        subprocess.Popen(["scrcpy"])

    def _ensure_scrcpy(self):
        if have("scrcpy"): return True
        if self._confirm("scrcpy not installed", "Install scrcpy now (arx install scrcpy)?"):
            self._term("install scrcpy", "arx install scrcpy; read -rp 'enter…'")
        return False

    def _mirror_rescue(self, *_):
        # the dead-display savior: mirror the broken screen to the PC, keep the phone awake,
        # turn its own (broken) panel off, and drive it with the PC mouse/keyboard
        if not self._ensure_scrcpy(): return
        subprocess.Popen(["scrcpy", "--stay-awake", "--turn-screen-off", "--show-touches"])

    def _mirror_otg(self, *_):
        # HID keyboard+mouse over USB - works even at the lock screen, no adb mirror needed
        if not self._ensure_scrcpy(): return
        self._term("scrcpy OTG (HID)", "scrcpy --otg; echo; read -rp 'enter to close…'")

    def _blind_unlock(self, *_):
        pin = self._prompt("Blind unlock", "Device PIN/password - sent over adb, no screen needed (PIN/password, not pattern)")
        if not pin: return
        cmd = ("adb shell input keyevent 224; sleep 0.5; "            # wake
               "adb shell input swipe 540 1600 540 400; sleep 0.5; "  # swipe up to the keyguard entry
               "adb shell input text %s; sleep 0.3; "                 # type the PIN
               "adb shell input keyevent 66; echo 'unlock sent'") % shlex.quote(pin)
        self._termrun("blind unlock", cmd)

